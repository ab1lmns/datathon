# Example only. Generate your own key; never commit .env.
CASHGUARD_API_KEY=replace-with-a-long-random-key
CASHGUARD_DATA_DIR=./data/service
CASHGUARD_JOB_TIMEOUT=300
CASHGUARD_MAX_UPLOAD_MB=200
CASHGUARD_KEEP_API_VIDEOS=0
HF_HOME=/workspace/.hf_home
HF_HUB_OFFLINE=1
FORTE_API_UPSTREAM=http://127.0.0.1:8000
