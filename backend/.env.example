# Example only. Generate your own key; never commit .env.
FORTE_API_KEY=replace-with-a-long-random-key
FORTE_DATA_DIR=./data/service
FORTE_JOB_TIMEOUT=285
# Maximum accepted unfinished jobs; excess uploads receive 429.
FORTE_MAX_ACTIVE_JOBS=2
FORTE_MAX_UPLOAD_MB=200
FORTE_KEEP_API_VIDEOS=0
HF_HOME=/workspace/.hf_home
HF_HUB_OFFLINE=1
FORTE_API_UPSTREAM=http://127.0.0.1:8000
# FORTE_FRONTEND_DIST=/absolute/path/to/frontend/dist
