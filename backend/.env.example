# Copy to .env and generate a key: python -c 'import secrets; print(secrets.token_urlsafe(32))'
FORTE_API_KEY=replace-with-a-random-key
FORTE_HOST=127.0.0.1
FORTE_PORT=8000
FORTE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
FORTE_DATA_DIR=data
FORTE_MAX_UPLOAD_MB=250
FORTE_MAX_PENDING_JOBS=4
# Includes upload and queue time; leaves a margin before the frontend's 300-second limit.
FORTE_JOB_TIMEOUT_SECONDS=270
FORTE_RETENTION_HOURS=24
FORTE_FFPROBE=ffprobe
